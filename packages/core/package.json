{
  "name": "@hippo-core/core",
  "version": "1.3.0",
  "description": "Private local memory shared by MCP-compatible AI agents",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "hippo-core": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./adapters/openclaw": "./src/adapters/openclaw.js",
    "./adapters/paperclip": "./src/adapters/paperclip.js",
    "./adapters/express": "./src/adapters/express.js",
    "./adapters/generic": "./src/adapters/generic.js",
    "./dashboard": "./src/dashboard/server.js",
    "./mcp": "./src/mcp/server.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "benchmark": "node benchmarks/run.js",
    "test:cross-agent": "node --test tests/cross-agent-mcp.test.js"
  },
  "files": [
    "src",
    "benchmarks",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "llm",
    "mcp",
    "openclaw",
    "paperclip",
    "hermes",
    "cursor",
    "claude-code",
    "codex",
    "embeddings",
    "vector",
    "hippocore"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "openai": "^4.20.0",
    "uuid": "^11.1.1"
  },
  "peerDependencies": {
    "openai": ">=4.0.0"
  }
}
